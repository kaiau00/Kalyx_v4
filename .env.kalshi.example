# Kalshi API credentials
KALSHI_API_KEY_ID=your_kalshi_api_key_id
# Backward-compatible alias also accepted by the bot:
# KALSHI_API_KEY=your_kalshi_api_key_id
KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/your/kalshi-private-key.pem
# Alternative to KALSHI_PRIVATE_KEY_PATH. Use escaped newlines if storing PEM in env.
# KALSHI_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Kalshi API environment
KALSHI_DEMO=true
# Production override:
# KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
# Demo override:
# KALSHI_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2
KALSHI_MARKET_STATUS=open
KALSHI_TIME_IN_FORCE=good_till_canceled

# BTC 15-minute market discovery
# Set one of these explicitly for live trading. The bot now fails closed without one
# unless KALSHI_ALLOW_KEYWORD_DISCOVERY=true is set intentionally.
KALSHI_BTC_SERIES_TICKER=
KALSHI_BTC_TICKER_PREFIX=
KALSHI_BTC_KEYWORDS=BTC,Bitcoin
KALSHI_ALLOW_KEYWORD_DISCOVERY=false
KALSHI_TARGET_CONTRACT_MINUTES=15
KALSHI_CONTRACT_DURATION_TOLERANCE_MINUTES=3

# External crypto candle feed
KALSHI_CANDLE_PROVIDER=coinbase
KALSHI_SPOT_SYMBOL=BTCUSDT
KALSHI_COINBASE_PRODUCT=BTC-USD
KALSHI_CANDLE_LIMIT=120

# Kalshi order book settings
KALSHI_ORDERBOOK_DEPTH=20

# Trading mode
# Default code behavior is dry-run unless --live is passed to run_kalshi_bot.py.
KALSHI_DRY_RUN=true

# Bankroll, EV, Kelly sizing, and risk gates
KALSHI_BANKROLL=1000.00
KALSHI_MAX_TRADE_DOLLARS=25.00
KALSHI_MAX_TOTAL_EXPOSURE=100.00
KALSHI_MAX_DAILY_LOSS=50.00
KALSHI_EV_THRESHOLD=0.01
KALSHI_FEE_PER_CONTRACT=0.10
KALSHI_KELLY_CAP=0.25
KALSHI_KELLY_MULTIPLIER=0.50
KALSHI_MIN_EDGE_AFTER_FEES=0.025
KALSHI_MAX_SPREAD_CENTS=3
KALSHI_MIN_TOP_DEPTH=5
KALSHI_MIN_MODEL_CONFIDENCE=0.20
KALSHI_LATE_TRADE_CUTOFF_SECONDS=90
KALSHI_DRAWDOWN_SIZE_REDUCTION_THRESHOLD=0.70
KALSHI_MODEL_PATH=kalshi_probability_model.json

# Strategy state and logs
KALSHI_SIGNAL_STATE=kalshi_signal_state.json
KALSHI_TRADE_LOG=kalshi_trades.jsonl
KALSHI_LEARNED_SETTLEMENTS=kalshi_learned_settlements.json

# Optional Telegram notifications for later wiring
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Optional Redis settings, kept for compatibility with the original bot tooling
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2
