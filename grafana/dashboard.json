{
  "dashboard": {
    "title": "Kalyx Kalshi Dashboard",
    "timezone": "browser",
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Total Trades",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
        "targets": [{"expr": "trading_total_trades_total", "refId": "A"}]
      },
      {
        "id": 2,
        "title": "Sharpe Ratio",
        "type": "stat",
        "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
        "targets": [{"expr": "trading_sharpe_ratio", "refId": "A"}]
      },
      {
        "id": 3,
        "title": "Max Drawdown",
        "type": "stat",
        "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
        "targets": [{"expr": "trading_max_drawdown", "refId": "A"}]
      },
      {
        "id": 4,
        "title": "Settlement Latency",
        "type": "stat",
        "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
        "targets": [{"expr": "trading_settlement_latency_seconds", "refId": "A"}]
      },
      {
        "id": 5,
        "title": "Signal Weight Drift",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
        "targets": [{"expr": "signal_weight", "legendFormat": "{{signal_name}}", "refId": "A"}]
      },
      {
        "id": 6,
        "title": "Per-Signal Edge",
        "type": "table",
        "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
        "targets": [{"expr": "signal_edge_avg", "format": "table", "instant": true, "refId": "A"}]
      },
      {
        "id": 7,
        "title": "Per-Signal Accuracy",
        "type": "table",
        "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
        "targets": [{"expr": "signal_accuracy_pct", "format": "table", "instant": true, "refId": "A"}]
      },
      {
        "id": 8,
        "title": "Edge Distribution",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
        "targets": [{"expr": "rate(trading_edge_after_fees_bucket[15m])", "legendFormat": "{{le}}", "refId": "A"}]
      },
      {
        "id": 9,
        "title": "Equity Curve",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
        "targets": [{"expr": "trading_total_pnl_cumulative", "legendFormat": "PnL", "refId": "A"}]
      },
      {
        "id": 10,
        "title": "Drawdown",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
        "targets": [{"expr": "trading_drawdown", "legendFormat": "Drawdown", "refId": "A"}]
      }
    ],
    "schemaVersion": 39,
    "version": 1
  }
}
